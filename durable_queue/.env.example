# 這份是設定清單的單一真相來源。settings.py 全部 no-default，
# 缺任何一個 → process 啟動即失敗（fail-fast）。複製成 .env 並填入實值。

# === Postgres ===
POSTGRES_DB=durable_queue
POSTGRES_USER=durable_queue
POSTGRES_PASSWORD=changeme

# === Worker & Django Api ===
# 本機直跑用 localhost；容器內由 compose 覆蓋成 postgres service name
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# 本機直跑用 localhost；容器內由 compose 覆蓋成 redis service name
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Django Server Secret Key
SECRET_KEY=

# 本機直跑用 True，讓 runserver 自動 serve static files（DRF 可瀏覽 API 的 CSS/JS）
DEBUG=True

# === Transcriber / Demo 旋鈕 ===
# 場景 A demo：TRANSCRIBE_SECONDS=15 / CELERY_VISIBILITY_TIMEOUT=30。
TRANSCRIBER=fake
TRANSCRIBE_SECONDS=1
CELERY_VISIBILITY_TIMEOUT=3600

# === Real transcriber (TRANSCRIBER=real 才需要，本機 opt-in 用) ===
# 只有在 real_transcribe() 實際被呼叫時才會讀取/要求，TRANSCRIBER=fake 或單純
# 跑 Django（manage.py/runserver）完全不需要設這組值。缺值時 job 會以帶有可執行
# 動作的錯誤訊息 FAILED，不會讓 process 啟動失敗、也不會把金鑰內容印進任何輸出。
# https://platform.openai.com/api-keys 取得。絕對不要 commit 真實金鑰。
OPENAI_API_KEY=
# 選用，有預設值：OpenAI 轉錄模型。
OPENAI_TRANSCRIBE_MODEL=whisper-1
# 選用，有預設值：下載/轉錄單一外部呼叫的逾時秒數。
REAL_TRANSCRIBE_TIMEOUT_SECONDS=120
# 選用，有預設值：允許轉錄的影片長度上限（秒），超過視為永久性輸入錯誤，不重試。
REAL_TRANSCRIBE_MAX_DURATION_SECONDS=1800

# Google OAuth 2.0 (from Google Cloud Console → Credentials → OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/
# Google callback 完成後 redirect 回的前端網址（Vite dev server）
FRONTEND_URL=http://localhost:5173

# 額外放行的前端 origin（逗號分隔）。localhost:5173 已內建，本機留空即可；
# 正式環境由 Terraform 注入 Vercel 的 origin。
CORS_ALLOWED_ORIGINS=
